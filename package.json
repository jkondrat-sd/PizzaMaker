{
  "name": "make-your-pizza",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack pizza-ordering app with a live visual builder and an event-driven Spring Boot + Kafka backend.",
  "author": "Uday Kanth Tirukkovaluri <t.uday.kanth12@gmail.com>",
  "license": "MIT",
  "homepage": "https://pizzamaker.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/udaykt/PizzaMaker.git"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.6.1",
    "@stomp/stompjs": "^6.1.2",
    "axios": "^1.16.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^7.2.6",
    "react-router-dom": "^5.2.1",
    "sockjs-client": "^1.6.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "start": "concurrently --names \"API,UI\" --prefix-colors \"cyan,green\" \"start-api.cmd\" \"vite\"",
    "fresh": "powershell -ExecutionPolicy Bypass -File fresh.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
